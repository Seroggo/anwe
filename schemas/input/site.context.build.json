{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anwe.dev/schemas/input/site.context.build.json",
  "title": "site.context.build input",
  "description": "Standalone strict input schema for the site.context.build skill. Mirrors the structure defined in SITE_CONTEXT_V0_1.md and is intentionally self-contained (no external $ref) so it can be validated without a JSON Schema resolver.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "context_hint"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Source"},
      "uniqueItems": false
    },
    "context_hint": {"$ref": "#/$defs/ContextHint"}
  },
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "StringOrNull": {"type": ["string", "null"]},
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "title", "content"],
      "properties": {
        "source_id": {"$ref": "#/$defs/NonEmptyString"},
        "source_type": {
          "enum": [
            "text",
            "brief",
            "notes",
            "website_extract",
            "document_extract",
            "research_extract",
            "other"
          ]
        },
        "title": {"$ref": "#/$defs/StringOrNull"},
        "content": {"$ref": "#/$defs/NonEmptyString"}
      }
    },
    "ContextHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_name", "purpose"],
      "properties": {
        "business_name": {"$ref": "#/$defs/StringOrNull"},
        "purpose": {"type": "string", "const": "website"}
      }
    }
  }
}
