{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anwe.local/schemas/site-blueprint.schema.json",
  "title": "ANWE SiteBlueprint",
  "type": "object",
  "required": [
    "schema_version",
    "blueprint_id",
    "version",
    "kind",
    "status",
    "title",
    "description",
    "applicability",
    "structure"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "blueprint_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^0\\.[0-9]+(?:\\.[0-9]+)?$"},
    "kind": {"type": "string", "enum": ["core", "archetype", "pattern", "vertical"]},
    "status": {"type": "string", "enum": ["draft", "review", "approved", "deprecated"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "extends": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "default": []
    },
    "conditional_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["blueprint", "if"],
        "properties": {
          "blueprint": {"type": "string"},
          "if": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "default": []
    },
    "applicability": {
      "type": "object",
      "required": ["business_models", "market_types", "signals"],
      "properties": {
        "business_models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "market_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sales_models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "signals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "structure": {
      "type": "object",
      "required": ["entities", "pages", "blocks", "actions", "evidence_types"],
      "properties": {
        "entities": {
          "type": "object",
          "required": ["required", "recommended"],
          "properties": {
            "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "recommended": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_type", "requirement", "purpose"],
            "properties": {
              "page_type": {"type": "string"},
              "requirement": {"type": "string", "enum": ["required", "recommended", "conditional"]},
              "purpose": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "blocks": {
          "type": "object",
          "required": ["required", "recommended"],
          "properties": {
            "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "recommended": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "actions": {
          "type": "object",
          "required": ["primary", "secondary"],
          "properties": {
            "primary": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "secondary": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "evidence_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "conditional_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["if", "then"],
        "properties": {
          "if": {"type": "string"},
          "then": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
