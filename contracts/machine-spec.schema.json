{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anwe.dev/contracts/machine-spec.schema.json",
  "title": "ANWE MachineSpec",
  "description": "Strict machine-readable page/entity semantics produced from SiteContext + SiteModel by site.machine.build, before Human rendering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "machine_id",
    "site_id",
    "source_context_id",
    "status",
    "primary_entity",
    "services",
    "pages",
    "decisions",
    "issues"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "machine_id": {"$ref": "#/$defs/Slug"},
    "site_id": {"$ref": "#/$defs/Slug"},
    "source_context_id": {"$ref": "#/$defs/Slug"},
    "status": {"enum": ["ready", "partial", "blocked"]},
    "primary_entity": {"$ref": "#/$defs/PrimaryEntity"},
    "services": {"type": "array", "items": {"$ref": "#/$defs/Service"}},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/MachinePage"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/Decision"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/Issue"}}
  },
  "$defs": {
    "Slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1},
    "NonEmptyString": {"type": "string", "minLength": 1},
    "StringOrNull": {"type": ["string", "null"]},
    "Path": {"type": "string", "pattern": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)*$"},
    "SchemaType": {"enum": ["Organization", "LocalBusiness", "ProfessionalService", "Person"]},
    "SemanticRole": {"enum": ["home", "offer", "demand", "contact", "about", "other"]},
    "OpenGraphType": {"const": "website"},
    "Contacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone", "email"],
      "properties": {
        "phone": {"anyOf": [{"$ref": "#/$defs/ContactValue"}, {"type": "null"}]},
        "email": {"anyOf": [{"$ref": "#/$defs/ContactValue"}, {"type": "null"}]}
      }
    },
    "ContactValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "href"],
      "properties": {
        "value": {"$ref": "#/$defs/NonEmptyString"},
        "href": {"type": "string", "oneOf": [{"pattern": "^tel:\\+?[0-9]+$"}, {"pattern": "^mailto:[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"}]}
      }
    },
    "PrimaryEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_type", "name", "description", "home_path", "contacts", "context_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/Slug"},
        "schema_type": {"$ref": "#/$defs/SchemaType"},
        "name": {"$ref": "#/$defs/NonEmptyString"},
        "description": {"$ref": "#/$defs/StringOrNull"},
        "home_path": {"const": "/"},
        "contacts": {"$ref": "#/$defs/Contacts"},
        "context_refs": {"type": "array", "items": {"$ref": "#/$defs/NonEmptyString"}}
      }
    },
    "Service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "provider_entity_id", "page_ids", "context_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/Slug"},
        "name": {"$ref": "#/$defs/NonEmptyString"},
        "description": {"$ref": "#/$defs/StringOrNull"},
        "provider_entity_id": {"$ref": "#/$defs/Slug"},
        "page_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Slug"}, "uniqueItems": true},
        "context_refs": {"type": "array", "items": {"$ref": "#/$defs/NonEmptyString"}}
      }
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {"$ref": "#/$defs/NonEmptyString"},
        "description": {"$ref": "#/$defs/StringOrNull"}
      }
    },
    "Canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/Path"}
      }
    },
    "Robots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "follow"],
      "properties": {
        "index": {"type": "boolean"},
        "follow": {"type": "boolean"}
      }
    },
    "OpenGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "description"],
      "properties": {
        "type": {"$ref": "#/$defs/OpenGraphType"},
        "title": {"$ref": "#/$defs/NonEmptyString"},
        "description": {"$ref": "#/$defs/StringOrNull"}
      }
    },
    "Breadcrumb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path"],
      "properties": {
        "label": {"$ref": "#/$defs/NonEmptyString"},
        "path": {"$ref": "#/$defs/Path"}
      }
    },
    "MachinePage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "path", "semantic_role", "meta", "canonical", "robots", "open_graph", "breadcrumbs", "primary_entity_id", "service_ids", "sitemap"],
      "properties": {
        "page_id": {"$ref": "#/$defs/Slug"},
        "path": {"$ref": "#/$defs/Path"},
        "semantic_role": {"$ref": "#/$defs/SemanticRole"},
        "meta": {"$ref": "#/$defs/Meta"},
        "canonical": {"$ref": "#/$defs/Canonical"},
        "robots": {"$ref": "#/$defs/Robots"},
        "open_graph": {"$ref": "#/$defs/OpenGraph"},
        "breadcrumbs": {"type": "array", "items": {"$ref": "#/$defs/Breadcrumb"}},
        "primary_entity_id": {"$ref": "#/$defs/Slug"},
        "service_ids": {"type": "array", "items": {"$ref": "#/$defs/Slug"}, "uniqueItems": true},
        "sitemap": {"type": "boolean"}
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "reason", "context_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/Slug"},
        "decision": {"$ref": "#/$defs/NonEmptyString"},
        "reason": {"$ref": "#/$defs/NonEmptyString"},
        "context_refs": {"type": "array", "items": {"$ref": "#/$defs/NonEmptyString"}}
      }
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "severity", "message", "context_ref", "page_id"],
      "properties": {
        "id": {"$ref": "#/$defs/Slug"},
        "type": {"enum": ["DATA_GAP"]},
        "severity": {"enum": ["critical", "important", "minor"]},
        "message": {"$ref": "#/$defs/NonEmptyString"},
        "context_ref": {"$ref": "#/$defs/StringOrNull"},
        "page_id": {"anyOf": [{"$ref": "#/$defs/Slug"}, {"type": "null"}]}
      }
    }
  }
}