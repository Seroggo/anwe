---
/**
 * Reusable Form shell renderer (NOT a block — not in Block Registry).
 *
 * Receives a SiteModel form shell and renders the physical HTML form.
 * Raw SiteModel form always has transport_status = "unwired". An optional
 * operator-owned connector can wire it after Review Build, without mutating
 * SiteModel or making transport part of the generic form contract.
 *
 * Unwired boundary:
 *   - <form data-transport-status="unwired">
 *   - submit control exists but is disabled
 *   - no action, no method, no fetch, no fake success
 *
 * Supported field types: text, email, tel, textarea.
 * Each label is bound to its control via for/id.
 * Placeholder is never used as a substitute for a label.
 */

import { asRecord, asString } from '../renderer/types';
import type { FormShell, FormField, FormConnector } from '../renderer/types';

interface Props {
  form: FormShell;
  connector?: FormConnector;
}

const { form, connector } = Astro.props;

if (form.transport_status !== 'unwired') {
  throw new Error(
    `Form "${form.id}" has transport_status "${form.transport_status}". Human Layer only renders unwired forms; wired transport is a QA/Final Assembly concern.`
  );
}

const isWired = Boolean(connector?.endpoint);

function parseField(raw: unknown): FormField {
  const rec = asRecord(raw);
  const name = asString(rec.name);
  const type = rec.type === 'email' || rec.type === 'tel' || rec.type === 'textarea' ? rec.type : 'text';
  return {
    name,
    type,
    label: asString(rec.label),
    placeholder: asString(rec.placeholder),
    required: rec.required === true,
    autocomplete: typeof rec.autocomplete === 'string' ? rec.autocomplete : null
  };
}

const fields = Array.isArray(form.fields) ? form.fields.map(parseField) : [];

function fieldId(field: FormField, index: number): string {
  const base = field.name.replace(/[^a-zA-Z0-9-]/g, '-').replace(/-{2,}/g, '-').replace(/^-|-$/g, '');
  return base ? `form-${form.id}-${base}` : `form-${form.id}-field-${index}`;
}
---

<form
  class="human-form"
  data-transport-status={isWired ? 'wired' : 'unwired'}
  data-gas-endpoint={connector?.endpoint}
  data-form-id={form.id}
  data-analytics-id={form.id}
  novalidate={false}
>
  {fields.length > 0 && (
    <ul class="human-form__fields">
      {fields.map((field, index) => {
        const id = fieldId(field, index);
        return (
          <li class="human-form__field">
            <label for={id}>
              {field.label}{field.required && <span class="human-form__required" aria-hidden="true">*</span>}
            </label>
            {field.type === 'textarea' ? (
              <textarea
                id={id}
                name={field.name}
                placeholder={field.placeholder}
                required={field.required}
                autocomplete={field.autocomplete ?? undefined}
                rows={4}
              ></textarea>
            ) : (
              <input
                id={id}
                name={field.name}
                type={field.type}
                placeholder={field.placeholder}
                required={field.required}
                autocomplete={field.autocomplete ?? undefined}
              />
            )}
          </li>
        );
      })}
    </ul>
  )}
  <div class="human-form__honeypot" aria-hidden="true">
    <label for={`form-${form.id}-honeypot`}>Leave this field empty</label>
    <input id={`form-${form.id}-honeypot`} name="_honeypot" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <button class="human-form__submit" type="submit" disabled={!isWired}>
    {form.submit_label}
  </button>
  <p class="human-form__status" aria-live="polite" hidden></p>
</form>

{isWired && (
  <script is:inline>
    document.querySelectorAll('form[data-transport-status="wired"]').forEach((form) => {
      if (!(form instanceof HTMLFormElement) || form.dataset.anweConnectorBound === 'true') return;
      form.dataset.anweConnectorBound = 'true';
      const endpoint = form.dataset.gasEndpoint;
      const button = form.querySelector('.human-form__submit');
      const status = form.querySelector('.human-form__status');
      if (!endpoint || !(button instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

      const setState = (state, message) => {
        form.dataset.submitState = state;
        button.disabled = state === 'submitting';
        status.textContent = message;
        status.hidden = !message;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = Object.fromEntries(new FormData(form).entries());
        data.pageUrl = window.location.href;
        data.source = document.referrer || '';
        data.userAgent = navigator.userAgent;
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((key) => {
          const value = new URLSearchParams(window.location.search).get(key);
          if (value) data[key] = value;
        });

        setState('submitting', 'Отправляем…');
        try {
          // GAS Web Apps generally do not expose CORS response headers. The
          // request is intentionally opaque; success means the browser handed
          // it to the endpoint, not that the response body was inspected.
          await fetch(endpoint, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(data)
          });
          form.reset();
          setState('success', 'Спасибо! Заявка отправлена.');
        } catch {
          setState('error', 'Не удалось отправить форму. Попробуйте ещё раз.');
          button.disabled = false;
        }
      });
    });
  </script>
)}
