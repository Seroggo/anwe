---
import ActionLink from '../ActionLink.astro';
import { asActions, asRecord, asString } from '../../renderer/types';
import type { Block } from '../../renderer/types';

interface Props {
  block: Block;
}

const { block } = Astro.props;
const content = asRecord(block.content);
const columns = Array.isArray(content.columns) ? content.columns.map((item) => asRecord(item)) : [];
const footerColumns = columns.map((column) => ({
  title: asString(column.title),
  links: Array.isArray(column.links) ? column.links.map((item) => {
    const link = asRecord(item);
    return { label: asString(link.label), href: asString(link.href, '#') };
  }) : []
}));
const actions = asActions(content.actions);
const year = new Date().getFullYear();
const surfaceClass = `surface--${block.surface}`;
const variantClass = `site-footer--${block.variant}`;
---

<footer class:list={['block', 'block--footer', surfaceClass, 'site-footer', variantClass]}>
  <div class="site-footer__lead">
    <a class="site-footer__brand" href="#top">{asString(content.brand, 'Красивые ноготочки')}</a>
    <p>{asString(content.description)}</p>
    {actions.length > 0 && <div class="action-row">{actions.map((action) => <ActionLink action={action} />)}</div>}
  </div>
  {footerColumns.length > 0 && <div class="site-footer__columns">{footerColumns.map((col) => <div><h3>{col.title}</h3><ul>{col.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>)}</div>}
  <div class="site-footer__bottom"><span>© {year} {asString(content.brand, 'Красивые ноготочки')}</span><span>{asString(content.note, 'Синтетический fixture для ANWE Block Library Alpha')}</span></div>
</footer>
