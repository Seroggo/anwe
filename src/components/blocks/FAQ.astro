---
import SectionIntro from '../SectionIntro.astro';
import { asRecord, asString } from '../../renderer/types';
import type { Block } from '../../renderer/types';

interface Props {
  block: Block;
}

const { block } = Astro.props;
const content = asRecord(block.content);
const items = Array.isArray(content.items) ? content.items.map((item) => asRecord(item)) : [];
const surfaceClass = `surface--${block.surface}`;
const variantClass = `faq-block--${block.variant}`;
---

<section id={block.id} class:list={['block', 'block--faq', surfaceClass, 'faq-block', variantClass]}>
  <SectionIntro eyebrow={asString(content.eyebrow)} title={asString(content.title)} description={asString(content.lead)} />
  <div class="faq-block__list">
    {items.map((item, index) => <details class="faq-item" data-debug-item-id={asString(item.id) || undefined} open={index === 0}><summary><span>{asString(item.question)}</span><span class="faq-item__icon" aria-hidden="true">+</span></summary><p>{asString(item.answer)}</p></details>)}
  </div>
</section>
