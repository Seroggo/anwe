---
/**
 * SMD (Мириад Систем) production-style route.
 *
 * Generic ANWE pipeline output: imports the site's SiteModel, MachineSpec and
 * ThemeSpec and renders the home page through the same PageRenderer used by the
 * Human Layer and Theme runtime proof routes. No business copy lives here — all
 * content comes from the canonical site artifacts.
 *
 * Mount base: "/" — the site is a single home page with same-page anchor nav,
 * so no rebasing is required; canonical stays the MachineSpec path.
 */

import PageRenderer from '../../renderer/PageRenderer.astro';
import siteModel from '../../../sites/smd/SITE_MODEL.json';
import machineSpec from '../../../sites/smd/MACHINE_SPEC.json';
import themeSpec from '../../../sites/smd/THEME_SPEC.json';
import type { MachineSpec } from '../../machine/structured-data';
import type { Block } from '../../renderer/types';
import type { ThemeSpec } from '../../theme/compile';

interface SiteModelPage {
  id: string;
  path: string;
  title: string;
  description: string | null;
  blocks: Block[];
}

const homePage = (siteModel as { pages: SiteModelPage[] }).pages.find((page) => page.id === 'home');

if (!homePage) {
  throw new Error('SMD SiteModel does not contain the required home page.');
}

const machine = machineSpec as unknown as MachineSpec;
const theme = themeSpec as unknown as ThemeSpec;
---

<PageRenderer page={homePage} machine={machine} mountBase="/" theme={theme} />