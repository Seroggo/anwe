---
/**
 * Generic test-only Theme runtime route (Stage 4A proof).
 *
 * Imports the accepted Human Layer fixture (SiteModel + MachineSpec) and a
 * synthetic ThemeSpec, and builds one static page per fixture page through the
 * SAME PageRenderer used in production, with a ThemeSpec applied via the
 * deterministic Theme Compiler (ThemeStyle bridge, wired through SiteLayout).
 *
 * This proves the Stage 4A non-blocking rule and the production runtime contract:
 * a ThemeSpec produced from a SiteContext whose `brand.desired_character` is
 * empty but whose grounded business context is sufficient compiles to a valid
 * ANWE CSS variable runtime and is applied to real blocks through the generic
 * renderer — WITHOUT breaking accepted Human Layer behavior.
 *
 * ThemeSpec is not site-identity-bound, so applying a synthetic ThemeSpec to the
 * Human fixture is valid for runtime proof.
 *
 * Mount base: "/test/theme-runtime/" — visible internal navigation hrefs are
 * rebased to the mount, while canonical stays the original MachineSpec path.
 * Same ThemeSpec is passed to every page.
 */

import type { GetStaticPaths } from 'astro';
import PageRenderer from '../../../renderer/PageRenderer.astro';
import siteModel from '../../../../tests/fixtures/human-layer/SITE_MODEL.json';
import machineSpec from '../../../../tests/fixtures/human-layer/MACHINE_SPEC.json';
import themeSpec from '../../../../tests/fixtures/theme-spec/fixture-a-output.json';
import type { MachineSpec } from '../../../machine/structured-data';
import type { Block } from '../../../renderer/types';
import type { ThemeSpec } from '../../../theme/compile';

const MOUNT_BASE = '/test/theme-runtime/';
const theme = themeSpec as unknown as ThemeSpec;

interface FixturePage {
  id: string;
  path: string;
  title: string;
  description: string | null;
  blocks: Block[];
}

export const getStaticPaths = (() => {
  const pages = (siteModel as { pages: FixturePage[] }).pages;
  const paths = pages.map((page) => ({
    params: { slug: page.path === '/' ? undefined : page.path.replace(/^\/|\/$/g, '') },
    props: { pageId: page.id }
  }));
  return paths;
}) as GetStaticPaths;

const { pageId } = Astro.props as { pageId: string };

const page = (siteModel as { pages: FixturePage[] }).pages.find((p) => p.id === pageId);
if (!page) {
  throw new Error(`Theme runtime route: fixture SiteModel has no page with id "${pageId}".`);
}

const machine = machineSpec as unknown as MachineSpec;
---

<PageRenderer page={page} machine={machine} mountBase={MOUNT_BASE} theme={theme} />